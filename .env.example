# Career-Agent Environment Configuration
# All core search, evaluation, tracking, and dashboard features run 100% locally with 0 cost.

# Server Configuration
PORT=3000
HOST=127.0.0.1

# Job Search Sources
FREEHIRE_BASE_URL=https://freehire.me/api/v1

# Optional Candidate Private Overrides (kept local via .env or data/candidate_profile.local.json)
# CANDIDATE_PHONE=+91-XXXXXXXXXX
# CANDIDATE_EMAIL=your.email@example.com
# CANDIDATE_FULL_NAME=Abhishek N

# Optional AI Providers (optional — local deterministic engine runs automatically with zero cost)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Integrations (disabled by default)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
# APIFY_API_TOKEN=
